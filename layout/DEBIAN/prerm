#!/bin/sh
JB=/var/jb; [ -d /var/jb/Library ] || JB=""
launchctl unload "$JB/Library/LaunchDaemons/com.johndie.triggrd.plist" 2>/dev/null
# Take the Triggr app off the Home Screen before its files go.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	[ -d "$JB/Applications/TriggrApp.app" ] && uicache -u "$JB/Applications/TriggrApp.app" >/dev/null 2>&1
fi
exit 0
