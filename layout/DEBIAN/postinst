#!/bin/sh
# Rootless: the jailbreak is under /var/jb. RootHide: its own tools (this
# script included) see the jailbreak folder as "/", so there's no prefix.
JB=/var/jb; [ -d /var/jb/Library ] || JB=""
# Show (or refresh) the Triggr app on the Home Screen.
[ -d "$JB/Applications/TriggrApp.app" ] && uicache -p "$JB/Applications/TriggrApp.app" >/dev/null 2>&1
# (Re)start triggrd, which runs commands where SpringBoard can't (iOS 18).
launchctl unload "$JB/Library/LaunchDaemons/com.johndie.triggrd.plist" 2>/dev/null
launchctl load "$JB/Library/LaunchDaemons/com.johndie.triggrd.plist" 2>/dev/null
exit 0
